{
    "name": "cookbook/kirby-video-placeholder",
    "description": "Generates a BlurHash placeholder from a video's first frame on upload",
    "type": "kirby-plugin",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-gd": "*",
        "kornrunner/blurhash": "^1.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Cookbook\\VideoPlaceholder\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Cookbook\\VideoPlaceholder\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "allow-plugins": {
            "getkirby/composer-installer": true
        }
    }
}
