{
    "name": "moritztheiselmann/kirby-video-placeholder",
    "description": "Generates a BlurHash placeholder from a video's first frame on upload",
    "type": "kirby-plugin",
    "license": "MIT",
    "homepage": "https://github.com/moritztheiselmann/kirby-video-placeholder",
    "authors": [
        {
            "name": "Moritz Theiselmann"
        }
    ],
    "support": {
        "issues": "https://github.com/moritztheiselmann/kirby-video-placeholder/issues",
        "source": "https://github.com/moritztheiselmann/kirby-video-placeholder"
    },
    "require": {
        "php": ">=8.2",
        "ext-gd": "*",
        "getkirby/composer-installer": "^1.2",
        "kornrunner/blurhash": "^1.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "MoritzTheiselmann\\VideoPlaceholder\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MoritzTheiselmann\\VideoPlaceholder\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "allow-plugins": {
            "getkirby/composer-installer": true
        }
    }
}
